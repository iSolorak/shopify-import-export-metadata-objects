# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env
#
# Local development: `shopify app dev` injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SCOPES and SHOPIFY_APP_URL for you, so locally you only need DATABASE_URL.
# On the VPS nothing is injected — every variable below must be set.

# ---- Shopify app credentials -------------------------------------------
# From the Partner dashboard: Apps > your app > Client credentials.
# SHOPIFY_API_KEY is the Client ID and is safe to expose to the browser.
SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET is the Client secret. Treat it like a password: it signs
# and verifies every webhook and OAuth callback.
SHOPIFY_API_SECRET=

# Public HTTPS origin of the deployed app. No trailing slash.
# Must match the Application URL configured in the Partner dashboard exactly.
SHOPIFY_APP_URL=https://app.example.com

# Comma separated, no spaces. Must match `access_scopes` in shopify.app.toml.
SCOPES=write_products,write_metaobjects,write_metaobject_definitions

# ---- Database ------------------------------------------------------------
# Local development (relative paths resolve against the prisma/ directory):
#   DATABASE_URL=file:dev.sqlite
# Production in Docker — absolute path onto the mounted volume:
DATABASE_URL=file:/data/prod.sqlite

# ---- Server --------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ---- Deployment ----------------------------------------------------------
# Loopback port the container publishes for the host nginx to proxy to.
# Change it if 3000 is already in use on the VPS, and update proxy_pass in
# deploy/nginx/shopify-app.conf to match.
APP_PORT=3000

# ---- Optional ------------------------------------------------------------
# Only needed when testing against a non-myshopify custom domain.
# SHOP_CUSTOM_DOMAIN=
